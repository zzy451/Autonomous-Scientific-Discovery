{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/asd/paper_module_taxonomy_assignments.schema.json",
  "title": "ASD Paper Module Taxonomy Assignment",
  "description": "One JSONL row in Data/paper_module_taxonomy_assignments.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_assignment_id",
    "paper_id",
    "module_context",
    "secondary_taxonomy_code",
    "tertiary_taxonomy_code",
    "assignment_status",
    "assigned_at",
    "assigned_by",
    "assignment_reason",
    "pending_reason",
    "source_primary_module_for_filing",
    "source_legacy_secondary_class",
    "source_legacy_tertiary_class",
    "mapping_source",
    "schema_version"
  ],
  "properties": {
    "module_assignment_id": {
      "type": "string",
      "pattern": "^PMTA-[0-9]{6}$"
    },
    "paper_id": {
      "type": "string",
      "pattern": "^ASD-[0-9]{4}$"
    },
    "module_context": {
      "type": "string",
      "enum": ["01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11"]
    },
    "secondary_taxonomy_code": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{2}\\.[0-9]{2}$"
    },
    "tertiary_taxonomy_code": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{2}$"
    },
    "assignment_status": {
      "type": "string",
      "enum": ["active_mapping", "pending_mapping"]
    },
    "assigned_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "assigned_by": {
      "type": "string",
      "minLength": 1
    },
    "assignment_reason": {
      "type": "string",
      "minLength": 1
    },
    "pending_reason": {
      "type": ["string", "null"]
    },
    "source_primary_module_for_filing": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{2}$"
    },
    "source_legacy_secondary_class": {
      "type": ["string", "null"]
    },
    "source_legacy_tertiary_class": {
      "type": ["string", "null"]
    },
    "mapping_source": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "assignment_status": {
            "const": "active_mapping"
          }
        }
      },
      "then": {
        "properties": {
          "secondary_taxonomy_code": {
            "type": "string"
          },
          "pending_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assignment_status": {
            "const": "pending_mapping"
          }
        }
      },
      "then": {
        "properties": {
          "secondary_taxonomy_code": {
            "type": "null"
          },
          "tertiary_taxonomy_code": {
            "type": "null"
          },
          "pending_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tertiary_taxonomy_code": {
            "type": "string"
          }
        }
      },
      "then": {
        "properties": {
          "secondary_taxonomy_code": {
            "type": "string"
          }
        }
      }
    }
  ]
}
